<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <EditText
            android:id="@+id/employeeName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Name"
            android:background="@drawable/input_bg"
            android:padding="12dp" />

        <EditText
            android:id="@+id/attendanceDate"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:hint="Date yyyy-MM-dd"
            android:background="@drawable/input_bg"
            android:padding="12dp" />

        <Spinner
            android:id="@+id/leaveType"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_bg" />

        <EditText
            android:id="@+id/timeIn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:hint="Time In 08:00"
            android:background="@drawable/input_bg"
            android:padding="12dp" />

        <EditText
            android:id="@+id/timeOut"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:hint="Time Out 18:00"
            android:background="@drawable/input_bg"
            android:padding="12dp" />

        <EditText
            android:id="@+id/location"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:hint="Location"
            android:background="@drawable/input_bg"
            android:padding="12dp" />

        <EditText
            android:id="@+id/paidHours"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:hint="Paid Hours"
            android:inputType="numberDecimal"
            android:background="@drawable/input_bg"
            android:padding="12dp" />

        <EditText
            android:id="@+id/hourlyRate"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:hint="Hourly Rate"
            android:inputType="numberDecimal"
            android:background="@drawable/input_bg"
            android:padding="12dp" />

        <EditText
            android:id="@+id/bonus"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:hint="Bonus"
            android:inputType="numberDecimal"
            android:background="@drawable/input_bg"
            android:padding="12dp" />

        <EditText
            android:id="@+id/deductions"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:hint="Deductions"
            android:inputType="numberDecimal"
            android:background="@drawable/input_bg"
            android:padding="12dp" />

        <Spinner
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_bg" />

        <EditText
            android:id="@+id/adminRemarks"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="8dp"
            android:gravity="top"
            android:hint="Admin Remarks"
            android:background="@drawable/input_bg"
            android:padding="12dp" />

    </LinearLayout>
</ScrollView>
