<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Admin Management Panel"
                android:textColor="#0F172A"
                android:textSize="25sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/logoutBtn"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:text="Logout"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#E50914"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="18dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search"
                android:textColor="#475569"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Name, date, leave, status"
                android:padding="12dp"
                android:backgroundTint="#CBD5E1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status"
                android:textColor="#475569"
                android:textStyle="bold"
                android:layout_marginTop="10dp"/>

            <Spinner
                android:id="@+id/statusFilter"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="#CBD5E1"/>

            <Button
                android:id="@+id/searchBtn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Search"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#1B3318"
                android:layout_marginTop="14dp"/>

            <Button
                android:id="@+id/clearBtn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Clear"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#64748B"
                android:layout_marginTop="10dp"/>

            <Button
                android:id="@+id/createBtn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Create Record"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#1B3318"
                android:layout_marginTop="10dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Requests and Attendance Records"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#020617"
                android:layout_marginBottom="14dp"/>

            <LinearLayout
                android:id="@+id/recordContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
